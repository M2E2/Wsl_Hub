{
  "language": "auto",
  "profiles": {
    "Qt 5.15 desktop": {
      "description": "Qt installed with the official installer in ~/Qt",
      "script": "",
      "vars": {
        "QTDIR": "~/Qt/5.15.2/gcc_64",
        "PATH": "${QTDIR}/bin:${PATH}",
        "CMAKE_PREFIX_PATH": "${QTDIR}",
        "LD_LIBRARY_PATH": "${QTDIR}/lib:${LD_LIBRARY_PATH}",
        "QT_PLUGIN_PATH": "${QTDIR}/plugins",
        "QML2_IMPORT_PATH": "${QTDIR}/qml",
        "QT_QPA_PLATFORM": "xcb"
      }
    },
    "Qt 6.8 desktop": {
      "description": "Qt installed with the official installer in ~/Qt",
      "script": "",
      "vars": {
        "QTDIR": "~/Qt/6.8.0/gcc_64",
        "PATH": "${QTDIR}/bin:${PATH}",
        "CMAKE_PREFIX_PATH": "${QTDIR}",
        "LD_LIBRARY_PATH": "${QTDIR}/lib:${LD_LIBRARY_PATH}",
        "QT_PLUGIN_PATH": "${QTDIR}/plugins",
        "QML_IMPORT_PATH": "${QTDIR}/qml",
        "QT_QPA_PLATFORM": "xcb"
      }
    },
    "Yocto SDK (cross-compilation)": {
      "description": "SDK generated with bitbake -c populate_sdk and installed in /opt",
      "script": "/opt/<distro>/<version>/environment-setup-<architecture>-poky-linux",
      "vars": {}
    }
  },
  "apps": [
    {
      "name": "Qt Creator",
      "command": "~/Qt/Tools/QtCreator/bin/qtcreator",
      "icon": "qtcreator",
      "cwd": "",
      "terminal": false,
      "profiles": [
        "Qt 5.15 desktop",
        "Qt 6.8 desktop",
        "Yocto SDK (cross-compilation)"
      ]
    },
    {
      "name": "htop",
      "command": "htop",
      "icon": "utilities-system-monitor",
      "cwd": "",
      "terminal": true,
      "profiles": []
    }
  ],
  "bookmarks": [
    {
      "name": "Home",
      "path": "~"
    },
    {
      "name": "Projects",
      "path": "~/projects"
    },
    {
      "name": "Windows C:",
      "path": "/mnt/c"
    }
  ]
}
